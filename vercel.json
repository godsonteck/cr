{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "vite",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/brands",
      "destination": "/api/catalog?resource=brands"
    },
    {
      "source": "/api/categories",
      "destination": "/api/catalog?resource=categories"
    },
    {
      "source": "/api/users/:id",
      "destination": "/api/users?id=:id"
    },
    {
      "source": "/api/admin-accounts/:id",
      "destination": "/api/settings?resource=admin-accounts&id=:id"
    },
    {
      "source": "/api/admin-accounts",
      "destination": "/api/settings?resource=admin-accounts"
    },
    {
      "source": "/api/wishlist",
      "destination": "/api/cart?resource=wishlist"
    },
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/products?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/products?sitemap=1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}