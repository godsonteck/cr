# Core app
NODE_ENV=development
PORT=3000
APP_URL=https://cosmeticse.vercel.app
PUBLIC_SITE_URL=https://cosmeticse.vercel.app

# Database (Supabase Postgres pooler connection string)
# Use the Supabase transaction pooler URL for serverless/Vercel deployments.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@crcosmetics.com
ADMIN_INITIAL_PIN=0000

# Optional third-party integrations
RESEND_API_KEY=
EMAIL_FROM="CR Cosmetics <onboarding@resend.dev>"
STORE_NOTIFICATION_EMAIL=crcosmetice@gmail.com
SENDGRID_API_KEY=
MOMO_MTN_API_KEY=
MOMO_TELECEL_API_KEY=
MOMO_AT_API_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=
GEMINI_API_KEY=
GA_MEASUREMENT_ID=

# Google Identity Services
# Use the same Web OAuth client ID in both variables. Never expose a client secret in VITE_* variables.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Paystack hosted checkout
PAYSTACK_SECRET_KEY=your-paystack-secret-key
VITE_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
