# Database
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require"

# App
APP_URL="https://your-app.vercel.app"
NODE_ENV="development"

# AI (Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Authentication (for future use)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
SESSION_SECRET="your-session-secret"

# Mobile Money (for future integration)
MOMO_MTN_API_KEY="your-mtn-momo-api-key"
MOMO_MTN_API_SECRET="your-mtn-momo-api-secret"
MOMO_MTN_SUBSCRIPTION_KEY="your-mtn-subscription-key"
MOMO_TELECEL_API_KEY="your-telecel-momo-api-key"
MOMO_TELECEL_API_SECRET="your-telecel-momo-api-secret"
MOMO_TELECEL_SUBSCRIPTION_KEY="your-telecel-subscription-key"
MOMO_AT_API_KEY="your-at-momo-api-key"
MOMO_AT_API_SECRET="your-at-momo-api-secret"
MOMO_AT_SUBSCRIPTION_KEY="your-at-subscription-key"

# Email (for order confirmations, etc.)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="orders@crcosmetics.com"

# File Storage (for product images)
AWS_S3_BUCKET="cr-cosmetics-images"
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_CLOUDFRONT_URL="https://cdn.crcosmetics.com"

# Analytics
GA_MEASUREMENT_ID="G-XXXXXXXXXX"